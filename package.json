{
  "name": "codex-cli-plus",
  "version": "0.3.12",
  "description": "A Windows desktop companion for Codex CLI: saved sessions, parallel terminals, and live activity status.",
  "main": "src/main.cjs",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron test/smoke.cjs",
    "test:codex": "electron test/codex-live.cjs",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/renderer.js && node --check src/terminal-utils.js && node --test test/*.test.cjs",
    "dist": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "appId": "com.local.codexcliplus",
    "productName": "Codex CLI Plus",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "portable"
    },
    "portable": {
      "artifactName": "Codex-CLI-Plus-${version}.exe"
    }
  }
}
